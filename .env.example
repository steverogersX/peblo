# ──────────────────────────────────────────────────────────────────────────────
# Peblo Notes — root .env.example
# Copy this file and fill in the values, then place it at backend/.env
# Never commit real credentials to the repository.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# URL of the frontend — used to set CORS allowed origin
CORS_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Example (local):  postgresql://postgres:password@localhost:5432/peblo
# Example (hosted): postgresql://user:pass@host:5432/peblo?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/peblo

# ── Authentication ────────────────────────────────────────────────────────────
# Used to sign and verify JWTs. Must be at least 32 characters.
# Generate a secure value with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars

# ── AI (Mistral) ──────────────────────────────────────────────────────────────
# Sign up for a free API key at https://console.mistral.ai
MISTRAL_API_KEY=your-mistral-api-key-here
# Model to use for summarisation — free-tier models work fine
MISTRAL_MODEL=mistral-small-latest

# ── Frontend (optional) ───────────────────────────────────────────────────────
# Only needed if you run the backend on a port other than 3001.
# Place this in frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:3001
