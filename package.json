{
  "name": "peblo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter @peblo/shared build && pnpm --filter @peblo/backend build && pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint && pnpm --filter @peblo/backend lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
